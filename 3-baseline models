# 03 — Baseline models

This notebook expects an authorised local CSV at `../data/input.csv`. Raw data are excluded from Git. Run cells from top to bottom.
from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd().parent / "src"))
import pandas as pd
from nursesleep_ai.pipeline import make_dirs, model_classification, model_regression

DATA_PATH = Path("../data/input.csv")
if not DATA_PATH.exists():
    raise FileNotFoundError("Add your authorised CSV as data/input.csv before running this notebook.")
df = pd.read_csv(DATA_PATH)
make_dirs()
print("Data shape:", df.shape)
print("Available columns:", df.columns.tolist())
model_classification(df, target="felt_rested")
model_regression(df, target="cognitive_performance_score")
print("Check results/metrics/ for the generated evaluation CSV files.")
