from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd() / 'src'))

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from nursesleep_ai.config import DATA_PATH, RESULTS_DIR
from nursesleep_ai.download_data import download_dataset
from nursesleep_ai.data import load_dataset, audit_dataset

sns.set_theme(style='whitegrid')
RESULTS_DIR.joinpath('figures').mkdir(parents=True, exist_ok=True)
RESULTS_DIR.joinpath('tables').mkdir(parents=True, exist_ok=True)
if not DATA_PATH.exists():
    download_dataset()
df = load_dataset(DATA_PATH)
print('Shape:', df.shape)
display(df.head())
Data quality audit
Review the output before proceeding. Missing values and duplicate rows are reported, not silently removed.
audit = audit_dataset(df)
print('Rows:', audit['rows'])
print('Columns:', audit['columns'])
print('Duplicate rows:', audit['duplicate_rows'])
print('Missing cells:', audit['missing_cells'])
display(audit['missing_by_column'].to_frame('missing_values'))
display(df.dtypes.astype(str).to_frame('dtype'))
display(df.describe(include='all').T)
## Category inspection
for col in ['occupation', 'shift_work', 'felt_rested', 'sleep_disorder_risk']:
    if col in df.columns:
        print(f'\\n{col}')
        display(df[col].value_counts(dropna=False).to_frame('count'))
## Sleep duration distribution
if 'sleep_duration_hrs' in df.columns:
    fig, ax = plt.subplots(figsize=(8, 5))
    sns.histplot(data=df, x='sleep_duration_hrs', kde=True, ax=ax)
    ax.set(title='Sleep duration distribution', xlabel='Sleep duration (hours)', ylabel='Records')
    fig.tight_layout()
    fig.savefig(RESULTS_DIR / 'figures' / 'sleep_duration_distribution.png', dpi=300)
    plt.show()
## Sleep duration by occupation
if {'occupation', 'sleep_duration_hrs'}.issubset(df.columns):
    fig, ax = plt.subplots(figsize=(12, 6))
    sns.boxplot(data=df, x='occupation', y='sleep_duration_hrs', ax=ax)
    ax.tick_params(axis='x', rotation=45)
    ax.set(title='Sleep duration by occupation', xlabel='Occupation', ylabel='Sleep duration (hours)')
    fig.tight_layout()
    fig.savefig(RESULTS_DIR / 'figures' / 'sleep_by_occupation.png', dpi=300)
    plt.show()
## Correlation heatmap
Correlation is descriptive and does not imply causation.
numeric = df.select_dtypes(include='number')
if numeric.shape[1] >= 2:
    fig, ax = plt.subplots(figsize=(13, 10))
    sns.heatmap(numeric.corr(), cmap='vlag', center=0, ax=ax)
    ax.set_title('Correlation matrix of numerical variables')
    fig.tight_layout()
    fig.savefig(RESULTS_DIR / 'figures' / 'numeric_correlation_heatmap.png', dpi=300)
    plt.show()
## Export an audit summary
summary = pd.DataFrame({
    'measure': ['rows', 'columns', 'duplicate_rows', 'missing_cells'],
    'value': [audit['rows'], audit['columns'], audit['duplicate_rows'], audit['missing_cells']]
})
summary.to_csv(RESULTS_DIR / 'tables' / 'dataset_audit.csv', index=False)
display(summary)
