
# ============================================================
# NURSESLEEP AI
# NOTEBOOK 01: DATA AUDIT AND EXPLORATORY DATA ANALYSIS
# ============================================================

import os
import zipfile
import warnings
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from google.colab import files
from IPython.display import display

warnings.filterwarnings("ignore")

# ------------------------------------------------------------
# 1. CREATE PROJECT FOLDERS
# ------------------------------------------------------------

os.makedirs("results/tables", exist_ok=True)
os.makedirs("results/figures", exist_ok=True)
os.makedirs("results/metrics", exist_ok=True)

print("NurseSleep AI - Notebook 01")
print("Project folders created successfully.")

# ------------------------------------------------------------
# 2. UPLOAD DATASET
# ------------------------------------------------------------

print("\nPlease upload your authorised CSV dataset.")

uploaded = files.upload()

csv_files = [f for f in uploaded.keys() if f.lower().endswith(".csv")]

if not csv_files:
    raise ValueError("No CSV file uploaded. Please upload a CSV dataset.")

file_path = csv_files[0]

df = pd.read_csv(file_path)

print("\nDataset loaded successfully!")
print("Dataset:", file_path)

# ------------------------------------------------------------
# 3. INITIAL DATA INSPECTION
# ------------------------------------------------------------

print("\nDATASET DIMENSIONS")
print("Rows:", df.shape[0])
print("Columns:", df.shape[1])

print("\nFIRST FIVE ROWS")
display(df.head())

print("\nCOLUMN NAMES")
print(df.columns.tolist())

print("\nDATA TYPES")
display(df.dtypes.to_frame("Data Type"))

# ------------------------------------------------------------
# 4. DATA QUALITY AUDIT
# ------------------------------------------------------------

missing_values = df.isnull().sum()

quality_report = pd.DataFrame({
    "Column": df.columns,
    "Data_Type": df.dtypes.astype(str).values,
    "Missing_Values": missing_values.values,
    "Missing_Percentage": (
        missing_values.values / len(df) * 100
    ).round(2),
    "Unique_Values": df.nunique(dropna=True).values
})

print("\nDATA QUALITY REPORT")
display(quality_report)

print("\nDuplicate rows:", df.duplicated().sum())

quality_report.to_csv(
    "results/tables/data_quality_report.csv",
    index=False
)

# ------------------------------------------------------------
# 5. DESCRIPTIVE STATISTICS
# ------------------------------------------------------------

numeric_columns = df.select_dtypes(
    include=np.number
).columns.tolist()

categorical_columns = df.select_dtypes(
    include=["object", "category", "bool"]
).columns.tolist()

if numeric_columns:
    descriptive_stats = df[numeric_columns].describe().T
    descriptive_stats.to_csv(
        "results/tables/descriptive_statistics.csv"
    )

    print("\nNUMERICAL DESCRIPTIVE STATISTICS")
    display(descriptive_stats)

if categorical_columns:
    categorical_summary = []

    for col in categorical_columns:
        categorical_summary.append({
            "Variable": col,
            "Unique_Categories": df[col].nunique(),
            "Most_Frequent": (
                df[col].mode().iloc[0]
                if not df[col].mode().empty else None
            ),
            "Most_Frequent_Count": (
                df[col].value_counts().iloc[0]
                if not df[col].dropna().empty else 0
            )
        })

    categorical_summary = pd.DataFrame(categorical_summary)

    categorical_summary.to_csv(
        "results/tables/categorical_summary.csv",
        index=False
    )

    print("\nCATEGORICAL SUMMARY")
    display(categorical_summary)

# ------------------------------------------------------------
# 6. NUMERICAL DISTRIBUTION PLOTS
# ------------------------------------------------------------

if numeric_columns:

    plot_columns = numeric_columns[:12]

    for col in plot_columns:

        values = df[col].dropna()

        if values.empty:
            continue

        plt.figure(figsize=(8, 5))
        plt.hist(values, bins=25, edgecolor="black")
        plt.title(f"Distribution of {col}")
        plt.xlabel(col)
        plt.ylabel("Frequency")
        plt.tight_layout()

        safe_name = "".join(
            c if c.isalnum() else "_"
            for c in col
        )

        plt.savefig(
            f"results/figures/distribution_{safe_name}.png",
            dpi=300
        )

        plt.show()
        plt.close()

# ------------------------------------------------------------
# 7. CATEGORICAL DISTRIBUTION PLOTS
# ------------------------------------------------------------

for col in categorical_columns[:8]:

    counts = df[col].value_counts().head(10)

    if counts.empty:
        continue

    plt.figure(figsize=(9, 5))
    counts.plot(kind="bar", edgecolor="black")

    plt.title(f"Category Distribution: {col}")
    plt.xlabel(col)
    plt.ylabel("Count")
    plt.xticks(rotation=45, ha="right")
    plt.tight_layout()

    safe_name = "".join(
        c if c.isalnum() else "_"
        for c in col
    )

    plt.savefig(
        f"results/figures/category_{safe_name}.png",
        dpi=300
    )

    plt.show()
    plt.close()

# ------------------------------------------------------------
# 8. CORRELATION HEATMAP
# ------------------------------------------------------------

if len(numeric_columns) >= 2:

    correlation = df[numeric_columns].corr()

    correlation.to_csv(
        "results/tables/correlation_matrix.csv"
    )

    plt.figure(figsize=(11, 8))

    plt.imshow(
        correlation,
        cmap="coolwarm",
        aspect="auto",
        vmin=-1,
        vmax=1
    )

    plt.colorbar(label="Correlation")

    plt.xticks(
        range(len(correlation.columns)),
        correlation.columns,
        rotation=90
    )

    plt.yticks(
        range(len(correlation.columns)),
        correlation.columns
    )

    plt.title("Correlation Heatmap")
    plt.tight_layout()

    plt.savefig(
        "results/figures/correlation_heatmap.png",
        dpi=300
    )

    plt.show()
    plt.close()

else:
    print("\nNot enough numeric columns for correlation analysis.")

# ------------------------------------------------------------
# 9. CHECK IMPORTANT PROJECT VARIABLES
# ------------------------------------------------------------

important_variables = [
    "Sleep Duration",
    "Quality of Sleep",
    "Stress Level",
    "Occupation",
    "felt_rested",
    "cognitive_performance_score"
]

print("\nIMPORTANT VARIABLE CHECK")

for variable in important_variables:

    matches = [
        col for col in df.columns
        if col.lower() == variable.lower()
    ]

    print(
        f"{variable}:",
        "Available" if matches else "Not found"
    )

# ------------------------------------------------------------
# 10. SAVE DATASET AUDIT SUMMARY
# ------------------------------------------------------------

summary = pd.DataFrame({
    "Measure": [
        "Total Rows",
        "Total Columns",
        "Duplicate Rows",
        "Total Missing Values",
        "Numerical Variables",
        "Categorical Variables"
    ],
    "Value": [
        len(df),
        len(df.columns),
        int(df.duplicated().sum()),
        int(df.isnull().sum().sum()),
        len(numeric_columns),
        len(categorical_columns)
    ]
})

summary.to_csv(
    "results/tables/dataset_audit_summary.csv",
    index=False
)

print("\nFINAL AUDIT SUMMARY")
display(summary)

# ------------------------------------------------------------
# 11. CREATE RESULTS ZIP
# ------------------------------------------------------------

zip_name = "NurseSleep_AI_Notebook01_Results.zip"

with zipfile.ZipFile(zip_name, "w", zipfile.ZIP_DEFLATED) as zf:

    for root, dirs, filenames in os.walk("results"):

        for filename in filenames:

            full_path = os.path.join(root, filename)

            zf.write(full_path, full_path)

print("\n======================================")
print("NOTEBOOK 01 COMPLETED SUCCESSFULLY!")
print("======================================")

print("\nGenerated files:")

for root, dirs, filenames in os.walk("results"):

    for filename in filenames:
        print(os.path.join(root, filename))

print("\nDownloading results ZIP...")

files.download(zip_name)
